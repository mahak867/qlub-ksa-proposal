{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "start": "node dist/main.js",
    "db:push": "prisma db push --skip-generate",
    "seed": "node dist/seed-cli.js",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://qlub:qlub@localhost:5432/qlubpay_test} prisma db push --skip-generate && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@qlub-pay/core": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
